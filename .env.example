# ─────────────────────────────────────────────────────────────
# Vasudev Guruji Official Platform — Environment Variables
# Copy to .env.local for local overrides. Never commit actual secret keys.
# ─────────────────────────────────────────────────────────────

# Canonical site address for SEO, canonical tags, JSON-LD, sitemap, and Open Graph previews.
VITE_SITE_URL=https://vg-virid.vercel.app

# Client routing mode: 'browser' (default) or 'memory' (for isolated testing/storyboard previews)
VITE_ROUTER=browser

# Optional Assistant integration (if serverless API /api/chat is deployed)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional: serve images & videos from Cloudflare R2 + CDN (see CLOUDFLARE_SETUP.md).
# Leave empty to serve media from the website itself.
# VITE_MEDIA_BASE_URL=https://media.your-domain.com/

# Only needed on the machine that runs `npm run media:upload` — put real values in .env.local, never here.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=vasudev-guruji-media
